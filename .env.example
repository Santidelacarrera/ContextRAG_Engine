# ContextRAG_Engine — valores de ejemplo. Copia a .env; nunca subas .env al repositorio.
# Los nombres siguen la convención CONTEXTRAG_<CAMPO> de contextrag/core/config.py.

# Presupuesto de evidencia que recibe el LLM (en tokens del estimador del chunker, no del modelo).
CONTEXTRAG_CONTEXT_BUDGET_TOKENS=4096
CONTEXTRAG_CONTEXT_SAFETY_MARGIN=0.10
CONTEXTRAG_CONTEXT_DEDUPE_JACCARD=0.8
CONTEXTRAG_CONTEXT_PLACEMENT=descending  # or edges (opt-in)

# Reranking remoto o por modelo: un timeout que, si se supera, falla la petición.
CONTEXTRAG_RERANKER_TIMEOUT_SECONDS=10

# Memoria conversacional (compactación en segundo plano).
CONTEXTRAG_MEMORY_COMPACT_THRESHOLD_TOKENS=2000
CONTEXTRAG_MEMORY_KEEP_RECENT_TURNS=6
CONTEXTRAG_MEMORY_WORKERS=2
CONTEXTRAG_MEMORY_QUEUE_LIMIT=64
CONTEXTRAG_MEMORY_JOB_MAX_ATTEMPTS=3
CONTEXTRAG_MEMORY_LEASE_SECONDS=300

# Conversaciones: ruta del SQLite de memoria (sin esta variable, /query rechaza conversation_id con 503).
MEMORY_DB=
