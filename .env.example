# ContextRAG_Engine — valores de ejemplo. Copia a .env; nunca subas .env al repositorio.
# Los nombres siguen la convención CONTEXTRAG_<CAMPO> de contextrag/core/config.py.

# Presupuesto de evidencia que recibe el LLM (en tokens del estimador del chunker, no del modelo).
CONTEXTRAG_CONTEXT_BUDGET_TOKENS=4096
CONTEXTRAG_CONTEXT_SAFETY_MARGIN=0.10
CONTEXTRAG_CONTEXT_DEDUPE_JACCARD=0.8
CONTEXTRAG_CONTEXT_PLACEMENT=descending  # or edges (opt-in)

# Reranking remoto o por modelo: un timeout que, si se supera, falla la petición.
CONTEXTRAG_RERANKER_TIMEOUT_SECONDS=10

# Memoria conversacional (compactación en segundo plano).
CONTEXTRAG_MEMORY_COMPACT_THRESHOLD_TOKENS=2000
CONTEXTRAG_MEMORY_KEEP_RECENT_TURNS=6
CONTEXTRAG_MEMORY_WORKERS=2
CONTEXTRAG_MEMORY_QUEUE_LIMIT=64
CONTEXTRAG_MEMORY_JOB_MAX_ATTEMPTS=3
CONTEXTRAG_MEMORY_LEASE_SECONDS=300

# Conversaciones: ruta del SQLite de memoria (sin esta variable, /query rechaza conversation_id con 503).
# Con MEMORY_DB el texto de los turnos y memorias se cifra con MASTER_KEY (por tenant). Sin MASTER_KEY el servidor no
# arranca; MEMORY_PLAINTEXT=1 lo permite solo en desarrollo. Bases anteriores al cifrado: `python -m contextrag memory-migrate`.
MEMORY_DB=
MEMORY_PLAINTEXT=

# Evaluación con juez LLM (RAGAS). Sin proveedor configurado el comando `ragas` se niega a ejecutarse.
# La clave se lee del entorno y nunca se escribe en informes ni en logs.
RAGAS_PROVIDER=                # anthropic | openai
RAGAS_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RAGAS_EMBEDDING_PROVIDER=      # openai (necesario para answer_relevancy; vacío = no se ejecuta)
RAGAS_EMBEDDING_MODEL=
RAGAS_CONCURRENCY=4
RAGAS_TIMEOUT_SECONDS=60
RAGAS_RETRIES=2
RAGAS_BACKOFF_SECONDS=1.0

# Ingestión: límites aplicados antes de analizar un archivo (413 si se supera el tamaño, 422 en el resto).
CONTEXTRAG_MAX_DOCUMENT_BYTES=25000000
CONTEXTRAG_MAX_PDF_PAGES=500
# Abstenerse si la pregunta nombra algo (palabra con mayúscula o identificador con dígitos) que la evidencia no menciona.
# Valores booleanos: true/false, 1/0, yes/no, on/off; cualquier otro valor es un error al arrancar.
CONTEXTRAG_REQUIRE_QUESTION_ENTITIES=true

# ---- Despliegue con docker compose (sin valores por defecto: compose se detiene si falta alguno) ----------------------
# Genere cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# y guárdelos en un gestor de secretos; este archivo es solo una plantilla y NO debe contener valores reales.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
# Clave maestra del cifrado en reposo (texto de fragmentos, memoria conversacional, caché Redis). 32 bytes o más.
# Si se pierde, los datos cifrados no se pueden recuperar. Rotación: README, sección «Gestión de claves».
MASTER_KEY=
MASTER_KEY_PREVIOUS=
# Claves de API por inquilino y caso (solo hashes); genérelas con `python -m contextrag keygen`.
CONTEXTRAG_KEYS_FILE=
# Con true, el servidor se niega a arrancar en modo abierto o con secreto compartido (obligatorio para varios usuarios).
CONTEXTRAG_REQUIRE_AUTH=true
# Redacción de secretos e identificadores en logs (activa por defecto; off solo para depurar con datos sintéticos).
CONTEXTRAG_LOG_REDACTION=on

# ---- Comportamiento de respuestas (valores por defecto seguros; ver README, «Estado para un piloto») ----------------
# Preguntas que nombran algo que la evidencia no menciona: resolver alias documentados y abstenerse en lo demás.
CONTEXTRAG_RESOLVE_ENTITY_ALIASES=true
# Fragmentos que parecen instrucciones dirigidas al modelo: se retiran de la generación y se marcan para revisión.
CONTEXTRAG_QUARANTINE_SUSPECTED_INJECTION=true
# Fuentes en conflicto: structured (fechas y cifras; heurística, NO semántica) | nli (requiere un modelo NLI con clase
# de contradicción y un umbral calibrado) | off.
CONTEXTRAG_CONFLICT_DETECTION=structured
CONTEXTRAG_CONFLICT_THRESHOLD=0.9
# Pregunta sin sujeto con varios asuntos en la evidencia: note (aviso) | clarify (pedir aclaración) | off.
CONTEXTRAG_AMBIGUITY_POLICY=note
# Trazas: off (solo contadores por etapa) | otel (requiere el extra otel y un exportador configurado por usted).
CONTEXTRAG_TRACING=off
# Límites de concurrencia: pasado el tiempo de espera, la petición recibe 503 con Retry-After.
CONTEXTRAG_MAX_CONCURRENT_QUERIES=16
CONTEXTRAG_MAX_CONCURRENT_INGESTS=4
CONTEXTRAG_BUSY_WAIT_SECONDS=2.0
# Rotación de la clave maestra: MASTER_KEY_PREVIOUS admite la(s) clave(s) anterior(es) mientras se re-cifra.
# MASTER_KEY_PREVIOUS=
